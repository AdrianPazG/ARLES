{
  "name": "arles-relay-app",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Interfaz de ARLES RELAY I. Presentación: sin lógica de negocio autoritativa.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "tokens": "python3 ../herramientas/design-tokens/generar.py --css",
    "sonda:tabla": "node pruebas/sondas/tabla.mjs",
    "sonda:csp": "node pruebas/sondas/csp.mjs",
    "sonda:teclado": "node pruebas/sondas/teclado.mjs",
    "sonda:ancho": "node pruebas/sondas/ancho.mjs",
    "sonda:plegado": "node pruebas/sondas/plegado.mjs",
    "sonda:lector": "node pruebas/sondas/lector.mjs",
    "sonda:cabecera": "node pruebas/sondas/cabecera.mjs",
    "sonda:tema": "node pruebas/sondas/tema.mjs"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.38",
    "@tauri-apps/api": "^2.11.1",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^17.12.0",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
