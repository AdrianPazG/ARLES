  "reglas": [
    {
      "titulo": "El cian vivo nunca es superficie con texto",
      "cuerpo": "<code>--arles-info</code> falla contra todo texto candidato, blanco incluido. Es color de trazo, borde, foco e icono — nunca relleno que cargue texto."
    },
    {
      "titulo": "El amarillo es luz, no señal",
      "cuerpo": "<code>--arles-accent</code> tiene luminancia relativa alta: más cerca del blanco que del negro. Brilla sobre fondo profundo y es ilegible con texto blanco encima."
    },
    {
      "titulo": "El color nunca va solo",
      "cuerpo": "Ningún estado se comunica únicamente por color. Todo indicador lleva además forma, icono o texto. Un usuario con daltonismo debe poder operar ARLES por completo."
    }
  ]
