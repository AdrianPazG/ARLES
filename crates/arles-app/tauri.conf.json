{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARLES RELAY",
  "version": "1.2.0",
  "identifier": "mx.telemetryinsight.arlesrelay",

  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../app run dev",
    "beforeBuildCommand": "npm --prefix ../app run build"
  },

  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "ARLES RELAY",
        "width": 1400,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],

    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "style-src": "'self'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["principal"]
    }
  },

  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "TELEMETRY INSIGHT",
    "copyright": "© TELEMETRY INSIGHT",
    "category": "Business",
    "shortDescription": "Ejecución controlada de campañas de correo",
    "longDescription": "ARLES RELAY ejecuta campañas de correo usando las cuentas y los límites de tu empresa, con idempotencia garantizada y métricas honestas.",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}